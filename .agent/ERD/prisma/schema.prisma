generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Digunakan oleh Supabase untuk koneksi pooling
}

// -----------------------------------------------------
// 1. USER & AUTHENTICATION
// -----------------------------------------------------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  tasks         Task[]          @relation("AssignedTasks")
  notes         Note[]
  flashcards    FlashcardDeck[]

  @@map("users")
}

// -----------------------------------------------------
// 2. PROJECT MANAGEMENT
// -----------------------------------------------------
model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  progress    Int       @default(0) // Persentase capaian (0-100)
  deadline    DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  ownerId String @map("owner_id")
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members ProjectMember[]
  tasks   Task[]
  notes   Note[] // Meeting notes yang terikat dengan proyek ini

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  role      String // Contoh: "Frontend", "Backend", "UI/UX", "PM"
  joinedAt  DateTime @default(now()) @map("joined_at")

  projectId String @map("project_id")
  userId    String @map("user_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // 1 User hanya punya 1 role spesifik per proyek
  @@map("project_members")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  deadline    DateTime?

  projectId String @map("project_id")
  assigneeId String? @map("assignee_id") // Siapa yang mengerjakan tugas ini (Role assignment)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

// -----------------------------------------------------
// 3. SMART NOTES & MEETING TRANSCRIPTS
// -----------------------------------------------------
model Note {
  id           String    @id @default(uuid())
  title        String
  content      String?   // Konten rich-text (JSON stringified dari Slate.js)
  audioUrl     String?   @map("audio_url") // Link file audio dari Supabase Storage
  transcript   String?   @db.Text // Hasil speech-to-text mentah
  summary      String?   @db.Text // Hasil rangkuman AI
  meetingDate  DateTime? @map("meeting_date") // Tanggal ditaruh di Kalender
  
  authorId  String  @map("author_id")
  projectId String? @map("project_id") // Opsional, jika note ini untuk proyek tertentu

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relasi ke Flashcard
  flashcardDecks FlashcardDeck[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}

// -----------------------------------------------------
// 4. ADAPTIVE LEARNING (FLASHCARDS)
// -----------------------------------------------------
model FlashcardDeck {
  id          String  @id @default(uuid())
  title       String
  description String?
  
  authorId String @map("author_id")
  noteId   String? @map("note_id") // Deck ini digenerate dari Note mana?

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  note   Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  cards Flashcard[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("flashcard_decks")
}

model Flashcard {
  id         String   @id @default(uuid())
  front      String   @db.Text // Pertanyaan
  back       String   @db.Text // Jawaban
  
  // Algoritma Spaced Repetition (SuperMemo-2 / SM2)
  nextReview DateTime @default(now()) @map("next_review")
  interval   Int      @default(0)   // Jarak hari review selanjutnya
  easeFactor Float    @default(2.5) @map("ease_factor") // Tingkat kesulitan (AI parameter)
  repetitions Int     @default(0)

  deckId String @map("deck_id")
  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}