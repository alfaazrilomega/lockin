/**
 * Prisma Schema — MERGED (LockIn + HR Task Manager)
 * 
 * This schema combines:
 * - All LockIn models (User, Project, Task, Notes, Chat, etc.)
 * - All HR Task Manager models (Profile, HRWorkspace, hr_tasks, etc.)
 * 
 * Both sets of models map to the same Supabase DB: pbbnhgjftmktxhjemrih
 * The HR models use the prefix "hr_" in their table names to avoid conflicts
 * with LockIn's own "tasks" and "workspaces" tables.
 * 
 * Usage after changes:
 *   npx prisma generate     <- regenerate client (always safe)
 *   npx prisma db pull      <- verify against live DB (read-only)
 *   npx prisma migrate dev  <- ONLY if you need schema changes (be careful!)
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════
// SECTION 1: HR TASK MANAGER MODELS
// ═══════════════════════════════════════════════════════════

model HRProfile {
  id         String   @id @db.Uuid
  full_name  String?
  avatar_url String?
  updated_at DateTime @updatedAt

  hr_tasks             HRTask[]
  hr_task_comments     HRTaskComment[]
  hr_notifications     HRNotification[]
  hr_activity_logs     HRActivityLog[]
  owned_hr_workspaces  HRWorkspace[]       @relation("HRWorkspaceOwner")
  hr_workspace_members HRWorkspaceMember[]

  @@map("hr_profiles")
}

model HRWorkspace {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  owner_id   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner   HRProfile         @relation("HRWorkspaceOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  members HRWorkspaceMember[]

  @@map("hr_workspaces")
}

model HRWorkspaceMember {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String   @db.Uuid
  user_id       String   @db.Uuid
  role          String   @default("member")
  invited_email String?
  status        String   @default("active")
  joined_at     DateTime @default(now())

  workspace HRWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      HRProfile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@map("hr_workspace_members")
}

model HRTask {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("medium")
  position    Int      @default(0)
  due_date    DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  owner       HRProfile        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comments    HRTaskComment[]
  attachments HRTaskAttachment[]
  tags        HRTaskTag[]
  activity    HRActivityLog[]

  @@index([title])
  @@index([status], type: Hash)
  @@map("hr_tasks")
}

model HRTaskComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String   @db.Uuid
  user_id    String   @db.Uuid
  content    String
  created_at DateTime @default(now())

  task   HRTask    @relation(fields: [task_id], references: [id], onDelete: Cascade)
  author HRProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("hr_task_comments")
}

model HRTaskAttachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id      String   @db.Uuid
  file_name    String
  file_path    String
  file_size    BigInt
  content_type String
  created_at   DateTime @default(now())

  task HRTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("hr_task_attachments")
}

model HRTag {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  @unique
  color_code String?

  tasks HRTaskTag[]

  @@map("hr_tags")
}

model HRTaskTag {
  task_id String @db.Uuid
  tag_id  String @db.Uuid

  task HRTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  tag  HRTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([task_id, tag_id])
  @@map("hr_task_tags")
}

model HRNotification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user HRProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("hr_notifications")
}

model HRActivityLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id        String?   @db.Uuid
  user_id        String    @db.Uuid
  action         String
  state_snapshot Json?
  created_at     DateTime  @default(now())

  task HRTask?   @relation(fields: [task_id], references: [id], onDelete: SetNull)
  user HRProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("hr_activity_logs")
}

// ═══════════════════════════════════════════════════════════
// SECTION 2: LOCKIN CORE MODELS
// ═══════════════════════════════════════════════════════════

model User {
  id        String   @id
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedProjects        Project[]         @relation("ProjectOwner")
  memberships          ProjectMember[]
  ownedWorkspaces      Workspace[]       @relation("OwnedWorkspaces")
  workspaceMemberships WorkspaceMember[]
  tasks                Task[]            @relation("AssignedTasks")
  notes                Note[]
  flashcards           FlashcardDeck[]
  sentShares           SharedResource[]  @relation("SentShares")
  receivedShares       SharedResource[]  @relation("ReceivedShares")
  profile              UserProfile?
  notifications        Notification[]
  personalTasks        PersonalTask[]
  tags                 Tag[]             // Universal Tags
  attachments          Attachment[]
  chatMessages         ChatMessage[]
  presence             UserPresence?
  taskComments         TaskComment[]
  activityLogs         WorkspaceActivity[] @relation("ActivityActor")
  salesContributor     SalesContributor?

  @@map("users")
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DEADLINE_CHANGED
  COMMENTED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  progress    Int           @default(0)
  status      ProjectStatus @default(PLANNING)
  priority    TaskPriority  @default(MEDIUM)
  
  // Fitur Kalender & Finansial (RIVIO Style)
  startDate   DateTime?     @map("start_date")
  deadline    DateTime?
  budget      Float?        @default(0)
  currentSpend Float?       @default(0) @map("current_spend")
  
  // Nested Projects
  parentId    String?       @map("parent_id")
  parent      Project?      @relation("SubProjects", fields: [parentId], references: [id], onDelete: Cascade)
  subProjects Project[]     @relation("SubProjects")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  ownerId     String        @map("owner_id")
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  workspaceId String?       @map("workspace_id")
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members     ProjectMember[]
  epics       Epic[]
  milestones  Milestone[]
  tasks       Task[]
  notes       Note[]
  shares      SharedResource[] @relation("SharedProjects")
  tags        ProjectTagAssignment[] // Universal Tags

  @@map("projects")
}

enum PermissionLevel {
  LEADER
  EDITOR
  VIEWER
}

model ProjectMember {
  id         String          @id @default(uuid())
  roleName   String          @map("role_name")
  permission PermissionLevel @default(EDITOR)
  joinedAt   DateTime        @default(now()) @map("joined_at")
  projectId  String          @map("project_id")
  userId     String          @map("user_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Workspace {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  ownerId     String   @map("owner_id")
  owner       User     @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)

  members      WorkspaceMember[]
  projects     Project[]
  tasks        Task[]
  chatRooms    ChatRoom[]
  noteFolders  NoteFolder[]
  activityLogs WorkspaceActivity[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String          @id @default(uuid())
  permission  PermissionLevel @default(VIEWER)
  joinedAt    DateTime        @default(now()) @map("joined_at")
  workspaceId String          @map("workspace_id")
  userId      String          @map("user_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  REVISION
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

// Eisenhower Quadrant
enum Quadrant {
  Q1 // Urgent & Important
  Q2 // Not Urgent but Important
  Q3 // Urgent but Not Important
  Q4 // Not Urgent & Not Important
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  quadrant    Quadrant?    // Sistem Kuadran RIVIO
  order       Float        @default(0)
  
  // Fitur Kalender
  startDate   DateTime?    @map("start_date")
  deadline    DateTime?
  
  storyPoints Int?         @map("story_points")
  timeSpent   Int?         @map("time_spent")
  proofUrl    String?      @map("proof_url")
  proofNotes  String?      @map("proof_notes") @db.Text
  feedback    String?      @db.Text
  
  // Hierarchy
  parentId    String?      @map("parent_id")
  parent      Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]       @relation("Subtasks")
  blocking    TaskDependency[] @relation("BlockingTasks")
  blockedBy   TaskDependency[] @relation("BlockedByTasks")
  
  epicId      String?      @map("epic_id")
  epic        Epic?        @relation(fields: [epicId], references: [id], onDelete: SetNull)
  milestoneId String?      @map("milestone_id")
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  projectId   String?      @map("project_id")
  workspaceId String       @map("workspace_id")
  assigneeId  String?      @map("assignee_id")
  
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  tags        TaskTagAssignment[] // Universal Tags
  
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(uuid())
  content   String    @db.Text
  taskId    String    @map("task_id")
  authorId  String    @map("author_id")
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Note {
  id          String    @id @default(uuid())
  title       String
  content     String?   @db.Text
  audioUrl    String?   @map("audio_url")
  transcript  String?   @db.Text
  summary     String?   @db.Text
  meetingDate DateTime? @map("meeting_date")
  wordCount   Int?      @map("word_count")
  isPinned    Boolean   @default(false) @map("is_pinned")
  parentId    String?   @map("parent_id")
  parent      Note?     @relation("NoteHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subpages    Note[]    @relation("NoteHierarchy")
  folderId    String?   @map("folder_id")
  folder      NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  authorId    String    @map("author_id")
  projectId   String?   @map("project_id")
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flashcardDecks FlashcardDeck[]
  shares      SharedResource[]    @relation("SharedNotes")
  tags        NoteTagAssignment[] // Universal Tags
  attachments Attachment[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("notes")
}

model FlashcardDeck {
  id          String  @id @default(uuid())
  title       String
  description String?
  authorId    String  @map("author_id")
  noteId      String? @map("note_id")
  author      User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  note        Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)
  cards       Flashcard[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("flashcard_decks")
}

model Flashcard {
  id          String   @id @default(uuid())
  front       String   @db.Text
  back        String   @db.Text
  nextReview  DateTime @default(now()) @map("next_review")
  interval    Int      @default(0)
  easeFactor  Float    @default(2.5) @map("ease_factor")
  repetitions Int      @default(0)
  deckId      String   @map("deck_id")
  deck        FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

enum ShareItemType {
  PROJECT
  NOTE
}

enum ShareStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum SharePermission {
  VIEW
  COPY
}

model SharedResource {
  id         String          @id @default(uuid())
  itemType   ShareItemType   @map("item_type")
  senderId   String          @map("sender_id")
  receiverId String          @map("receiver_id")
  status     ShareStatus     @default(PENDING)
  permission SharePermission @default(VIEW)
  projectId  String?         @map("project_id")
  noteId     String?         @map("note_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  sender     User            @relation("SentShares", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User            @relation("ReceivedShares", fields: [receiverId], references: [id], onDelete: Cascade)
  project    Project?        @relation("SharedProjects", fields: [projectId], references: [id], onDelete: Cascade)
  note       Note?           @relation("SharedNotes", fields: [noteId], references: [id], onDelete: Cascade)

  @@map("shared_resources")
}

model Epic {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  projectId   String  @map("project_id")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("epics")
}

model Milestone {
  id        String    @id @default(uuid())
  title     String
  dueDate   DateTime? @map("due_date")
  projectId String    @map("project_id")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("milestones")
}

model TaskDependency {
  id            String @id @default(uuid())
  blockingId    String @map("blocking_id")
  blockedById   String @map("blocked_by_id")
  blockingTask  Task   @relation("BlockingTasks", fields: [blockingId], references: [id], onDelete: Cascade)
  blockedByTask Task   @relation("BlockedByTasks", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([blockingId, blockedById])
  @@map("task_dependencies")
}

model NoteFolder {
  id          String    @id @default(uuid())
  name        String
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes       Note[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("note_folders")
}

model WorkspaceActivity {
  id         String    @id @default(uuid())
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  metadata   Json?
  workspaceId String   @map("workspace_id")
  actorId    String    @map("actor_id")
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      User      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("workspace_activities")
}

model UserProfile {
  id          String  @id @default(uuid())
  bio         String? @db.Text
  headline    String?
  website     String?
  location    String?
  githubUrl   String? @map("github_url")
  linkedinUrl String? @map("linkedin_url")
  twitterUrl  String? @map("twitter_url")
  userId      String  @unique @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

enum NotificationType {
  SHARE_RECEIVED
  TASK_ASSIGNED
  TASK_REVIEW
  TASK_APPROVED
  TASK_REVISION
  WORKSPACE_INVITE
  CHAT_MENTION
  AI_DIGEST
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  actionUrl String?          @map("action_url")
  metadata  Json?
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

enum PersonalTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model PersonalTask {
  id           String             @id @default(uuid())
  title        String
  description  String?            @db.Text
  status       PersonalTaskStatus @default(PENDING)
  priority     TaskPriority       @default(MEDIUM)
  tags         String[]
  dueDate      DateTime?          @map("due_date")
  isRecurring  Boolean            @default(false) @map("is_recurring")
  recurPattern String?            @map("recur_pattern")
  completedAt  DateTime?          @map("completed_at")
  order        Float              @default(0)
  userId       String             @map("user_id")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("personal_tasks")
}

// ═══════════════════════════════════════════════════════════
// UNIVERSAL TAG SYSTEM (Replaces NoteTag)
// ═══════════════════════════════════════════════════════════

model Tag {
  id     String              @id @default(uuid())
  name   String
  color  String              @default("#2383E2")
  userId String              @map("user_id")
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  notes    NoteTagAssignment[]
  tasks    TaskTagAssignment[]
  projects ProjectTagAssignment[]

  @@unique([userId, name])
  @@map("tags") // Dulu "note_tags"
}

model NoteTagAssignment {
  noteId String @map("note_id")
  tagId  String @map("tag_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tag_assignments")
}

model TaskTagAssignment {
  taskId String @map("task_id")
  tagId  String @map("tag_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tag_assignments")
}

model ProjectTagAssignment {
  projectId String  @map("project_id")
  tagId     String  @map("tag_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tag_assignments")
}

// ═══════════════════════════════════════════════════════════
// OTHER MODELS
// ═══════════════════════════════════════════════════════════

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Attachment {
  id               String          @id @default(uuid())
  fileName         String          @map("file_name")
  fileType         String          @map("file_type")
  fileSize         Int             @map("file_size")
  storageUrl       String          @map("storage_url")
  publicUrl        String?         @map("public_url")
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  extractedText    String?         @map("extracted_text") @db.Text
  aiSummary        String?         @map("ai_summary") @db.Text
  noteId           String?         @map("note_id")
  uploaderId       String          @map("uploader_id")
  note             Note?           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  uploader         User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("attachments")
}

enum ChatRoomType {
  WORKSPACE
  PROJECT
  DIRECT
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

model ChatRoom {
  id          String       @id @default(uuid())
  name        String
  type        ChatRoomType @default(WORKSPACE)
  workspaceId String?      @map("workspace_id")
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("chat_rooms")
}

model ChatMessage {
  id        String      @id @default(uuid())
  content   String      @db.Text
  type      MessageType @default(TEXT)
  fileUrl   String?     @map("file_url")
  roomId    String      @map("room_id")
  senderId  String      @map("sender_id")
  room      ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  editedAt  DateTime?   @map("edited_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model UserPresence {
  id          String   @id @default(uuid())
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  currentPath String?  @map("current_path")
  isOnline    Boolean  @default(false) @map("is_online")
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

model SalesContributor {
  id       String @id @default(uuid())
  userId   String @unique @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  revenue  Float  @default(0)
  leadsBlack Int  @default(0)
  leadsGrey  Int  @default(0)
  kpi      Float  @default(0)
  winPct   String @default("0%")
  wlBlack  Int    @default(0)
  wlGrey   Int    @default(0)
  platformMetrics PlatformMetric[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_contributors")
}

model PlatformMetric {
  id            String           @id @default(uuid())
  contributorId String           @map("contributor_id")
  contributor   SalesContributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  platformName  String
  percentage    Float            @default(0)
  revenue       Float            @default(0)

  @@map("platform_metrics")
}

model DashboardDeal {
  id               String   @id @default(uuid())
  referrerCategory String
  amount           Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("dashboard_deals")
}