{
  "name": "Phase 3 — Validate",
  "nodes": [
    {
      "id": "webhook-validate",
      "name": "Webhook — Receive Created Video",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 350],
      "parameters": {
        "path": "validate-video",
        "responseMode": "onReceived",
        "httpMethod": "POST"
      }
    },
    {
      "id": "gemini-validator",
      "name": "Gemini 3.5 Flash — Genre Validator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 350],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "key", "value": "={{ $env.GEMINI_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "contents": [
            {
              "parts": [
                {
                  "text": "={{ 'Kamu adalah Validator Konten YouTube yang ketat dan profesional.\\n\\nDATA VIDEO:\\n' + JSON.stringify($json.body) + '\\n\\nEVALUASI video ini berdasarkan kriteria berikut:\\n1. Apakah hook-nya menarik dalam 5 detik pertama?\\n2. Apakah genre sudah benar sesuai yang direncanakan?\\n3. Apakah konten sesuai untuk audiens Indonesia?\\n4. Apakah ada masalah konten (SARA, negatif, dll)?\\n5. Apakah thumbnail-nya akan menarik di YouTube?\\n\\nBALAS HANYA dengan JSON ini (tanpa markdown):\\n{\\n  \"primary_genre\": \"Comedy/Education/Gaming/Vlog/Tutorial/Entertainment\",\\n  \"secondary_genre\": \"Comedy/Education/null\",\\n  \"content_rating\": \"Family/Teen/Mature\",\\n  \"scores\": {\\n    \"hook_strength\": 0,\\n    \"humor_level\": 0,\\n    \"educational_value\": 0,\\n    \"production_quality\": 0,\\n    \"overall\": 0\\n  },\\n  \"verdict\": \"APPROVED/NEEDS_REVISION/REJECTED\",\\n  \"revision_notes\": \"null atau alasan revisi\",\\n  \"thumbnail_style\": \"bold_comedy/minimalist/gaming_dark/educational_clean\",\\n  \"thumbnail_prompt\": \"prompt spesifik untuk Imagen generate thumbnail 1280x720\",\\n  \"thumbnail_text\": \"teks singkat untuk thumbnail (max 5 kata)\",\\n  \"youtube_category_id\": \"23\"\\n}' }
              ]
            }
          ],
          "generationConfig": {
            "temperature": 0.3,
            "maxOutputTokens": 2048,
            "responseMimeType": "application/json"
          }
        }
      }
    },
    {
      "id": "parse-validation",
      "name": "Parse Validation Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 350],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst text = raw.candidates[0].content.parts[0].text;\nconst validation = JSON.parse(text);\nconst jobData = $('Webhook — Receive Created Video').first().json.body;\nreturn [{\n  json: {\n    ...jobData,\n    validation,\n    status: validation.verdict === 'APPROVED' ? 'validated' : 'needs_revision'\n  }\n}];"
      }
    },
    {
      "id": "check-verdict",
      "name": "Check Verdict",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 350],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.validation.verdict }}",
              "rightValue": "APPROVED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "update-approved",
      "name": "Update Supabase — Approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 250],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/pipeline_jobs?job_id=eq.{{ $json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "status": "validated",
          "primary_genre": "={{ $json.validation.primary_genre }}",
          "thumbnail_style": "={{ $json.validation.thumbnail_style }}",
          "thumbnail_prompt": "={{ $json.validation.thumbnail_prompt }}",
          "validation_scores": "={{ JSON.stringify($json.validation.scores) }}"
        }
      }
    },
    {
      "id": "trigger-publish",
      "name": "Trigger Phase 4 — Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1500, 250],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_URL }}webhook/publish-video",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ $json }}"
      }
    },
    {
      "id": "update-rejected",
      "name": "Update Supabase — Needs Revision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 500],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/pipeline_jobs?job_id=eq.{{ $json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "status": "needs_revision",
          "revision_notes": "={{ $json.validation.revision_notes }}"
        }
      }
    }
  ],
  "connections": {
    "Webhook — Receive Created Video": { "main": [[{ "node": "Gemini 3.5 Flash — Genre Validator", "type": "main", "index": 0 }]] },
    "Gemini 3.5 Flash — Genre Validator": { "main": [[{ "node": "Parse Validation Result", "type": "main", "index": 0 }]] },
    "Parse Validation Result": { "main": [[{ "node": "Check Verdict", "type": "main", "index": 0 }]] },
    "Check Verdict": {
      "main": [
        [{ "node": "Update Supabase — Approved", "type": "main", "index": 0 }],
        [{ "node": "Update Supabase — Needs Revision", "type": "main", "index": 0 }]
      ]
    },
    "Update Supabase — Approved": { "main": [[{ "node": "Trigger Phase 4 — Publish", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  }
}
